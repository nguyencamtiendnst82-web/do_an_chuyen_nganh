PORT=5000
NODE_ENV=development

# Cấu hình kết nối MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT Bí mật dùng để ký và xác thực token (Thay đổi trong môi trường production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=8h

# CORS Allowed Origin
CLIENT_URL=                          

# SMTP gửi email xác minh tài khoản và đặt lại mật khẩu
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Chỉ bật (false) khi demo và gặp lỗi "self-signed certificate" do diệt virus; để trống khi triển khai thật
SMTP_TLS_REJECT_UNAUTHORIZED=

# Đăng nhập Google (Client ID công khai, dùng cho demo tại http://localhost:5173)
GOOGLE_CLIENT_ID=

# Thời gian đệm (phút) giữa hai lượt phục vụ của cùng một nhân viên (mặc định 15)
APPOINTMENT_BUFFER_MINUTES=15

# Giới hạn cứng số ngày được đặt trước (khách chỉ chọn được ngày đã xếp ca)
BOOKING_MAX_DAYS_AHEAD=30

# Khách chỉ được tự hủy/đổi lịch trước giờ hẹn ít nhất N giờ (mặc định 2)
CANCEL_MIN_HOURS=2

# Chờ khách bao nhiêu phút sau giờ hẹn thì mới được đánh dấu "không đến" (mặc định 15)
NO_SHOW_GRACE_MINUTES=15

# Khách có bao nhiêu giờ để trả lời đề xuất đổi nhân viên/dời lịch của spa (mặc định 12)
CHANGE_REQUEST_HOURS=12

# Nhân viên được tự giảm giá tối đa bao nhiêu % tổng hóa đơn (mặc định 20); admin không bị giới hạn
INVOICE_STAFF_MAX_DISCOUNT_PERCENT=20
