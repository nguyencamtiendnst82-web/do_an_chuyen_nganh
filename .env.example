PORT=5000
NODE_ENV=development

# Cấu hình kết nối MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_spa_db

# JWT Bí mật dùng để ký và xác thực token (Thay đổi trong môi trường production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=8h

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
